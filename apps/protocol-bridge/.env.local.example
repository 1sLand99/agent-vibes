# Production deploy config — copy to .env.local (never commit .env.local)
#
# Synced to GitHub Secrets as PROXY_ENV_PRODUCTION via:
#   npm run deploy:sync
# or automatically at the end of:
#   npm run release

PORT=2026
PROXY_API_KEY=replace-with-your-strong-secret
AGENT_VIBES_DATA_DIR=/opt/protocol-bridge

# ChatGPT Web Live uses OAuth accounts from codex-accounts.json.
# Per-account proxyUrl and optional deviceId stay in the existing account file.
CHATGPT_WEB_VOICE_ENDPOINT=https://chatgpt.com/realtime/wm?dcid=0
CHATGPT_WEB_VOICE_TRANSPORT=auto
CHATGPT_WEB_VOICE_PYTHON=/opt/protocol-bridge/.venv-chatgpt-web/bin/python
CHATGPT_WEB_VOICE_LANGUAGE=zh-CN
CHATGPT_WEB_VOICE_TIMEZONE=Etc/GMT-8
CHATGPT_WEB_VOICE_TIMEZONE_OFFSET_MINUTES=-480
CHATGPT_WEB_VOICE_TIMEOUT_MS=20000
